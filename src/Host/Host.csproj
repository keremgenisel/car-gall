<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CarGallery.Host</RootNamespace>
    <AssemblyName>CarGallery.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Modules/VehicleCatalog/VehicleCatalog/VehicleCatalog.csproj" />
    <ProjectReference Include="..\Modules\VehicleReference\VehicleReference\VehicleReference.csproj" />
    <ProjectReference Include="..\Modules\Content\Content\Content.csproj" />
    <ProjectReference Include="..\Modules\Dealership\Dealership\Dealership.csproj" />
    <ProjectReference Include="..\Modules\Identity\Identity\Identity.csproj" />
    <ProjectReference Include="..\Modules\Leads\Leads\Leads.csproj" />
    <ProjectReference Include="..\Modules\Media\Media\Media.csproj" />
    <ProjectReference Include="..\Modules\Notifications\Notifications\Notifications.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Host.Tests" />
  </ItemGroup>

  <!--
    `0004` D12 · P2 — belgenin sabit metinleri ön yüz deposunun çeviri dosyalarından gelir
    (Host'ta metin tutulmaz). Vitrin kataloğu, SEO kümesi ve listenin parametre adları (P3)
    derleme ve yayın çıktısına `i18n/` altında bağlanır. Panel kümesi bağlanmaz: belgeye girmez.
    `Dockerfile`'ın arka yüz aşaması aynı dosyaları kopyalar.
  -->
  <ItemGroup>
    <Content Include="..\..\frontend\src\shared\i18n\locales\*.json" Link="i18n\vitrin\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\frontend\src\shared\i18n\locales\seo\*.json" Link="i18n\seo\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\frontend\src\features\catalog\listQueryParams.json" Link="i18n\listQueryParams.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
